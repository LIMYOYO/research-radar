{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-radar.local/schemas/candidate.schema.json",
  "title": "Research Radar candidate paper",
  "type": "object",
  "required": ["schema_version", "identity", "identity_status", "title", "discovered_by", "access_status", "evidence_level"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {"type": "string", "minLength": 1},
    "identity_status": {"enum": ["persistent", "title-fallback"]},
    "doi": {"type": ["string", "null"]},
    "openalex_id": {"type": ["string", "null"]},
    "semantic_scholar_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "year": {"type": ["integer", "null"]},
    "venue": {"type": ["string", "null"]},
    "abstract": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "discovered_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "access_status": {"enum": ["full-text", "accepted-manuscript", "abstract", "metadata-only", "request"]},
    "evidence_level": {"enum": ["full-text", "abstract", "metadata"]},
    "scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "relationship": {"enum": ["supports", "contradicts", "extends", "competes", "method-lead", "background", "unknown"]},
    "recommended_action": {"enum": ["read-now", "cite", "watch", "known", "off-topic", "weak", "duplicate"]}
  },
  "additionalProperties": true
}
